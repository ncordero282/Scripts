function Get-AadErrorCodeFromException {
    param([System.Exception]$Exception)
    $msg = $null
    try { $msg = $_.ErrorDetails.Message } catch {}
    if (-not $msg) { $msg = $Exception.Message }
    if ($msg -match "authorization_pending") { return "authorization_pending" }
    if ($msg -match "slow_down")             { return "slow_down" }
    if ($msg -match "expired_token")         { return "expired_token" }
    try { $j = $msg | ConvertFrom-Json -ErrorAction Stop; if ($j.error) { return [string]$j.error } } catch {}
    return $null
}

