function Test-IsAdmin {
    try {
        $p = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
        return $p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    } catch { return $false }
}

function Set-RegDword {
    param([string]$Path,[string]$Name,[int]$Value)
    if (-not (Test-Path $Path)) { New-Item -Path $Path -Force | Out-Null }
    New-ItemProperty -Path $Path -Name $Name -PropertyType DWord -Value $Value -Force | Out-Null
}

function Set-RegStringList {
    param([string]$Path,[string[]]$Values)
    if (-not (Test-Path $Path)) { New-Item -Path $Path -Force | Out-Null }
    try {
        (Get-Item -Path $Path).GetValueNames() | ForEach-Object {
            Remove-ItemProperty -Path $Path -Name $_ -ErrorAction SilentlyContinue
        }
    } catch {}
    $i = 1
    foreach ($v in $Values) {
        New-ItemProperty -Path $Path -Name "$i" -PropertyType String -Value $v -Force | Out-Null
        $i++
    }
}

function Get-EdgeExePath {
    $candidates = @(
        "$env:ProgramFiles(x86)\Microsoft\Edge\Application\msedge.exe",
        "$env:ProgramFiles\Microsoft\Edge\Application\msedge.exe"
    )
    foreach ($p in $candidates) { if (Test-Path $p) { return $p } }
    return $null
}

function Initialize-EdgeForMicrosoftLogin {
    $policyRoot = "HKLM:\SOFTWARE\Policies\Microsoft\Edge"
    Set-RegDword -Path $policyRoot -Name "HideFirstRunExperience"     -Value 1
    Set-RegDword -Path $policyRoot -Name "PromotionalTabsEnabled"     -Value 0
    Set-RegDword -Path $policyRoot -Name "ShowRecommendationsEnabled" -Value 0
    Set-RegDword -Path $policyRoot -Name "BlockThirdPartyCookies"     -Value 0
    $allowed = @(
        "https://microsoft.com","https://*.microsoft.com",
        "https://microsoft.com/devicelogin","https://login.microsoftonline.com",
        "https://*.login.microsoftonline.com","https://*.microsoftonline.com",
        "https://device.login.microsoftonline.com","https://*.msauth.net","https://*.msftauth.net"
    )
    Set-RegStringList -Path (Join-Path $policyRoot "PopupsAllowedForUrls")  -Values $allowed
    Set-RegStringList -Path (Join-Path $policyRoot "CookiesAllowedForUrls") -Values $allowed
}

function Start-EdgeDeviceLogin {
    param([string]$Url = "https://microsoft.com/devicelogin")
    Initialize-EdgeForMicrosoftLogin
    Get-Process msedge -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
    $edgeExe = Get-EdgeExePath
    if (-not $edgeExe) { Start-Process $Url | Out-Null; return }
    $args = @("--no-first-run","--no-default-browser-check","--disable-features=msEdgeFirstRunExperience",$Url)
    Start-Process -FilePath $edgeExe -ArgumentList $args | Out-Null
}

