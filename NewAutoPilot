function Request-DeviceCode {
    if (-not (Test-IsAdmin)) { Write-Host "Please run PowerShell in elevated mode"; return }
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

    $postParams = @{ resource = "$global:resource"; client_id = "$global:clientId" }
    $DevicecodeResponse = Invoke-RestMethod -Method POST -Uri "$global:authUrl/oauth2/devicecode" -Body $postParams
    $global:Devicecode = $DevicecodeResponse

    $loginUrl = "https://microsoft.com/devicelogin"
    if ($DevicecodeResponse.verification_url) { $loginUrl = $DevicecodeResponse.verification_url }

    Write-Host "Code: $($DevicecodeResponse.user_code)"
    Write-Host "URL: $loginUrl"

    # Launch Edge
    Start-EdgeDeviceLogin -Url $loginUrl

    # Auto-type logic
    try {
        Add-Type -AssemblyName System.Windows.Forms
        Write-Host "Waiting for browser..."
        Start-Sleep -Seconds 4
        Write-Host "Typing code..."
        [System.Windows.Forms.SendKeys]::SendWait($DevicecodeResponse.user_code)
    } catch { Write-Host "Auto-type failed." }

    # Show Window
    return Show-DeviceCodeWindow -Code $DevicecodeResponse.user_code -Url $loginUrl
}

function WaitFor-Token {
    if (-not $global:Devicecode) { throw "Device code not requested." }
    $expiresIn = 900
    $interval  = 5
    try {
        if ($global:Devicecode.expires_in) { $expiresIn = [int]$global:Devicecode.expires_in }
        if ($global:Devicecode.interval)   { $interval  = [int]$global:Devicecode.interval }
    } catch {}

    $deadline = (Get-Date).AddSeconds($expiresIn)
    $tokenParams = @{
        grant_type = "device_code"
        resource   = "$global:resource"
        client_id  = "$global:clientId"
        code       = "$($global:Devicecode.device_code)"
    }

    Write-Host "Waiting for user to complete sign-in..." -NoNewline

    while ((Get-Date) -lt $deadline) {
        try {
            $tokenResponse = Invoke-RestMethod -Method POST -Uri "$global:authUrl/oauth2/token" -Body $tokenParams
            Write-Host " Success!" -ForegroundColor Green
            return $tokenResponse
        }
        catch {
            $err = Get-AadErrorCodeFromException -Exception $_.Exception
            if ($err -eq "authorization_pending") {
                Write-Host "." -NoNewline
                Start-Sleep -Seconds $interval
                continue
            }
            if ($err -eq "slow_down") {
                Start-Sleep -Seconds ($interval + 5)
                continue
            }
            throw "Error: $err"
        }
    }
    throw "Timeout."
}

function Upload-AutopilotData {
    param([Parameter(Mandatory)]$Token)

    if (-not (Test-IsAdmin)) { Write-Host "Need Admin rights."; return }

    Write-Host "Gathering Hardware Hash (this takes a moment)..."
    $DeviceHashData = (Get-WmiObject -Namespace "root/cimv2/mdm/dmmap" -Class "MDM_DevDetail_Ext01" -Filter "InstanceID='Ext' AND ParentID='./DevDetail'" -Verbose:$false).DeviceHardwareData
    $SerialNumber   = (Get-WmiObject -Class "Win32_BIOS" -Verbose:$false).SerialNumber

    Write-Host "Serial: $SerialNumber"

    $body = @{
        "SerialNumber"   = "$SerialNumber"
        "DeviceHashData" = "$DeviceHashData"
        "token_type"     = "$($Token.token_type)"
        "id_token"       = "$($Token.id_token)"
        "access_token"   = "$($Token.access_token)"
    }

    $params = @{
        ContentType = "application/json"
        Headers     = @{ "Date" = "$(Get-Date)" }
        Body        = ($body | ConvertTo-Json)
        Method      = "Post"
        URI         = $global:webhookurl
    }

    Invoke-RestMethod @params
    Write-Host "Upload Complete. Check your email." -ForegroundColor Cyan
}

# ---------------------------
# Execution Flow
# ---------------------------
try {
    # 1. Start the visual flow
    $ui = Request-DeviceCode
    
    # 2. Block script here until user finishes login in browser
    $token = WaitFor-Token
    
    # 3. IMMEDIATELY close the window once token is grabbed
    try { if ($ui -and $ui.IsVisible) { $ui.Close() } } catch {}

    # 4. Upload data
    Upload-AutopilotData -Token $token
}
catch {
    Write-Error $_
}
finally {
    Stop-Transcript | Out-Null
}
